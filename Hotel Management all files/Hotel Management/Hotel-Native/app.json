{
  "expo": {
    "name": "Ajalkar Hotel POS & Billing",
    "slug": "ajalkar-hotel-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#7C2D12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ajalkar.hotelmanagement",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Allows the app to connect to the Hotel Management POS local server."
      }
    },
    "android": {
      "package": "com.ajalkar.hotelmanagement"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
